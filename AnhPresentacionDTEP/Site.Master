            <asp:Label ID="lblUsuario" runat="server" Text="" CssClass="usuario_conectado"></asp:Label>
            <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/Sitio/Persona/wfSalir.aspx">
