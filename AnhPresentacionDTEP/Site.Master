    <script type="text/javascript">
        var c = "http://www.google.com/recaptcha/api/reload?c=03AHJ_VuuEHcJPIDvYS1qmT3nXriCanwGcIQvkyZnTXN5h-Yuxmdk0f2qP5kBilzLooH-J_57LCwXzZvPxmgCSHWMiMLaSXVOy7AZCzbUVJFdKq9dkr4RwiKFDukwdlHwHG3V3aHnwHNkDvf3ckhK7uc2TGFbZc6gZpg&k=6LcdWNUSAAAAAMGvuBnVU0M1DHGYMPVMPWgVqDZ3&reason=r&type=image";

        function fechaActual(formato) {
            var fecha = new Date();
            var diames = fecha.getDate();
            var diasemana = fecha.getDay();
            var mes = fecha.getMonth() + 1;
            var anio = fecha.getFullYear();

            var textosemana = new Array(7);
            textosemana[0] = "Domingo";
            textosemana[1] = "Lunes";
            textosemana[2] = "Martes";
            textosemana[3] = "Miércoles";
            textosemana[4] = "Jueves";
            textosemana[5] = "Viernes";
            textosemana[6] = "Sábado";

            var textomes = new Array(12);
            textomes[1] = "Enero";
            textomes[2] = "Febrero";
            textomes[3] = "Marzo";
            textomes[4] = "Abril";
            textomes[5] = "Mayo";
            textomes[6] = "Junio";
            textomes[7] = "Julio";
            textomes[8] = "Agosto";
            textomes[9] = "Septiembre";
            textomes[10] = "Octubre";
            textomes[11] = "Noviembre";
            textomes[12] = "Diciembre";


            switch (formato) {
                case "dd/mm/yyyy":
                    return diames + "/" + mes + "/" + anio;
                case "dd":
                    return diames;
                case "mm":
                    return mes;
                case "yyyy":
                    return anio;
                case "w":
                    return diasemana;
                case "ww dd/mm/yyyy":
                    return textosemana[diasemana] + " " + diames + "/" + mes + "/" + anio;
                case "text":
                    return textosemana[diasemana] + ", " + diames + " de " + textomes[mes] + " de " + anio;
                default:
                    return fecha;
            }
        }

        function pageLoad(sender, args) {
            var tooltip = $("#tooltip");
            $(".showtooltip").hover(
                function (e) {
                    var sender = $(this);
                    tooltip.text(sender.attr("alt"));
                    tooltip.css("left", e.pageX - 40);
                    tooltip.css("top", e.pageY - 40);
                },
                function (e) {
                    tooltip.css("left", -9000);
                    tooltip.css("top", 0);
                }
            );
            try {
                afterLoad(sender, args);
            } catch (e) { }
        };
    </script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
        
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="Form1" runat="server" method="post">
    <div class="page">
