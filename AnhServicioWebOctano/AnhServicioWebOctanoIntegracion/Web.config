    <add key="CorreoPuerto" value="25" />
    <add key="CorreoDe" value="sistemas@anh.gob.bo" />
    <add key="CorreoCco" value="jpflores@anh.gob.bo, rangulo@anh.gob.bo" />
    <!-- Parametro de unidades de medida-->
    <add key="PoderCalorifico" value="BTU/MMPC,BTU/PC" />
    <add key="Glp" value="BBL/MMPCD,BBL/MMMCD" />
    <add key="Volumen" value="MMPCD,MMMCD" />
    <add key="PuntoRocio" value="°F" />
