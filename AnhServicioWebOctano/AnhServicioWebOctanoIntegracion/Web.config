      <add name="APP_CANTCAL.PUSR_REPORTES.P_REPORTE_REGISTRO_CALIDAD.RefCursor.O_REPORTE_REG_CALIDAD_CTY" value="implicitRefCursor bindinfo='mode=Output'" />
      
      <!--LISTADOS-->
      <add name="APP_CANTCAL.PUSR_LISTADOS.P_LISTADO_CATALOGO_CALIDAD.RefCursor.O_CATALOGO_CALIDAD_CTY" value="implicitRefCursor bindinfo='mode=Output'" />

      <!--GESTION-->
